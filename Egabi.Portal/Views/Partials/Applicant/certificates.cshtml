@using System.Globalization
@using Egabi.Portal.Services.Applicant
@using Egabi.Portal.Services.InspectPro
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@inject InspectProApiClient Api
@{
    // Certificates & licences — real data from the egabi Platform API (NFSA Patch N4; replaces the sample).
    // Every certificate issued to me or to one of my establishments: download the PDF to print and
    // display it, open its public verification page, or copy the verification link.
    var isAr = CultureInfo.CurrentCulture.Name.StartsWith("ar", StringComparison.OrdinalIgnoreCase);
    string L(string en, string ar) => isAr ? ar : en;
    string U(string path) => (isAr ? "" : "/en") + path;
    string T(string? en, string? ar) => (isAr ? (string.IsNullOrWhiteSpace(ar) ? en : ar) : (string.IsNullOrWhiteSpace(en) ? ar : en)) ?? "—";

    var me = ApplicantAuth.Current(Context)!;
    var result = await Api.GetMyCertificatesAsync(me.Token);
    var list = result.Data ?? new List<CertificateItem>();
    var site = Context.Request.Scheme + "://" + Context.Request.Host;
}

<div class="gp-screen">
<div class="gp-phead"><div><h1>@L("Certificates and licences", "الشهادات والتراخيص")</h1><p>@L("Print your licence and display it in a clear, visible place at the establishment. Anyone can check it by scanning its QR code.", "اطبع الترخيص وعلّقه في مكان ظاهر وواضح بالمنشأة. يمكن لأي شخص التحقق منه بمسح رمز QR.")</p></div></div>

@if (result.Unauthorized)
{
    await ApplicantAuth.SignOutAsync(Context);
    <div class="gp-form-error">@L("Your session has ended.", "انتهت الجلسة.") <a class="gp-textlink" href="@U("/account/login")?returnUrl=@Uri.EscapeDataString(U("/account/certificates"))">@L("Sign in again", "سجّل الدخول مرة أخرى")</a></div>
}
else if (!result.Ok)
{
    <div class="gp-form-error">@L("Your certificates could not be loaded right now. Please refresh the page in a moment.", "تعذر تحميل الشهادات حاليًا. أعد تحميل الصفحة بعد قليل.")</div>
}
else if (list.Count == 0)
{
    <div class="gp-panel gp-center">
    <h2 class="gp-h3">@L("No certificates yet", "لا توجد شهادات بعد")</h2>
    <p class="gp-muted">@L("When NFSA grants your establishment's food licence, its certificate appears here, ready to print.", "عند منح الهيئة ترخيص منشأتك الغذائية تظهر شهادته هنا جاهزة للطباعة.")</p>
    <a class="gp-btn gp-btn--primary" href="@U("/account/new-request")?code=FOOD_LICENCE"><i class="bi bi-patch-check"></i><span>@L("Request a food establishment licence", "طلب ترخيص منشأة غذائية")</span></a>
    </div>
}
else
{
    <div class="gp-certs">
    @foreach (var c in list)
    {
        var verifyPath = U("/verify") + "?code=" + Uri.EscapeDataString(c.VerificationCode);
        <article class="gp-cert">
        <div class="gp-cert-seal"><i class="bi @ApplicantUi.CertificateIcon(c.CertificateType)"></i></div>
        <div class="gp-cert-body">
        <span class="gp-cert-kind">@T(c.TitleEn, c.TitleAr)</span>
        <h2>@T(c.HolderNameEn, c.HolderNameAr)</h2>
        <dl>
        <dt>@L("Certificate no.", "رقم الشهادة")</dt><dd class="gp-ref">@c.CertificateNumber</dd>
        <dt>@L("Issued", "تاريخ الإصدار")</dt><dd>@ApplicantUi.Date(c.IssuedAt, isAr)</dd>
        <dt>@L("Valid until", "صالحة حتى")</dt><dd>@(c.ValidUntil.HasValue ? ApplicantUi.Date(c.ValidUntil, isAr) : L("No expiry", "بدون تاريخ انتهاء"))</dd>
        <dt>@L("Verification code", "رمز التحقق")</dt><dd class="gp-ref">@c.VerificationCode</dd>
        <dt>@L("Status", "الحالة")</dt><dd><span class="@ApplicantUi.CertificateStatusPill(c.Status)">@ApplicantUi.CertificateStatusLabel(c.Status, isAr)</span></dd>
        </dl>
        </div>
        <div class="gp-cert-actions">
        <a class="gp-btn gp-btn--primary gp-btn--sm" href="/portal/certificates/@Uri.EscapeDataString(c.CertificateNumber)/pdf@(isAr ? "" : "?lang=en")" target="_blank" rel="noopener"><i class="bi bi-printer"></i><span>@L("Open PDF to print", "فتح PDF للطباعة")</span></a>
        <a class="gp-btn gp-btn--outline gp-btn--sm" href="@verifyPath" target="_blank" rel="noopener"><i class="bi bi-qr-code-scan"></i><span>@L("Verification page", "صفحة التحقق")</span></a>
        <button class="gp-btn gp-btn--ghost gp-btn--sm" type="button" data-copy="@(site + verifyPath)" data-toast-ar="تم نسخ رابط التحقق" data-toast-en="Verification link copied"><i class="bi bi-link-45deg"></i><span>@L("Copy verification link", "نسخ رابط التحقق")</span></button>
        </div>
        </article>
    }
    </div>
}
</div>
