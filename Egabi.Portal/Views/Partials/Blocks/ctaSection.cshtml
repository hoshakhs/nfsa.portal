@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.Blocks
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockListItem>
@{
    var c = Model.Content;
    var button = (c.Value<IEnumerable<Link>>("button") ?? Enumerable.Empty<Link>()).FirstOrDefault();
}
<div class="gp-wrap gp-section gp-section--tight">
    <div class="gp-cta">
        <div>
            <h2>@(c.Value<string>("title"))</h2>
            <p>@(c.Value<string>("text"))</p>
        </div>
        @if (button != null)
        {
            <a href="@button.Url" target="@button.Target" class="gp-btn gp-btn--gold">@button.Name</a>
        }
    </div>
</div>
