  <Properties>
    <intro>
      <Value Culture="ar-EG"><![CDATA[كل الخدمات الإلكترونية للهيئة، بشروطها ومستنداتها ومدة إنجازها.]]></Value>
      <Value Culture="en-US"><![CDATA[Every NFSA e-service, with its conditions, documents and expected time.]]></Value>
    </intro>
    <sections>
      <Value Culture="ar-EG"><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "7a1e6c52-3b8d-4f09-a2c4-5d6e7f8a9b10",
      "key": "87f0cf21-fd73-5f4e-beff-14178f3fb9f2",
      "values": [
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "الخدمات المتاحة إلكترونيًا"
        },
        {
          "alias": "intro",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "اختر خدمة لعرض شروطها ومستنداتها ورسومها ومدة إنجازها، ثم ابدأ الطلب."
        }
      ]
    },
    {
      "contentTypeKey": "62cd108b-d89b-513a-b90a-2847279e7631",
      "key": "7460df1e-9e55-5094-bf55-02df29adcae4",
      "values": [
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "مجموعات الخدمات"
        },
        {
          "alias": "cards",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "contentData": [
              {
                "contentTypeKey": "91a1f03c-2da9-57ba-a891-9b4dba49ccd8",
                "key": "afff5973-49d4-51ad-ad14-d1cd7355b992",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "bi-building"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "المنشآت الغذائية"
                  },
                  {
                    "alias": "text",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "تسجيل منشأة غذائية، وتعديل التسجيل وتجديده، والانضمام إلى القائمة البيضاء."
                  }
                ]
              },
              {
                "contentTypeKey": "91a1f03c-2da9-57ba-a891-9b4dba49ccd8",
                "key": "4b84d03d-9f80-54c5-89df-e0de77613d6b",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "bi-box-seam"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "الواردات"
                  },
                  {
                    "alias": "text",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "ترخيص مستورد أغذية، والإخطار المسبق عن الرسائل، والإفراج عنها، والتظلمات."
                  }
                ]
              },
              {
                "contentTypeKey": "91a1f03c-2da9-57ba-a891-9b4dba49ccd8",
                "key": "5412fb09-31b3-539e-bd64-692e345f0b64",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "bi-globe2"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "الصادرات"
                  },
                  {
                    "alias": "text",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "الشهادة الصحية للتصدير، والقيد في قوائم الدول المستوردة."
                  }
                ]
              },
              {
                "contentTypeKey": "91a1f03c-2da9-57ba-a891-9b4dba49ccd8",
                "key": "8b27093b-b7ac-53b6-b4da-db5e06c2a89c",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "bi-capsule"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "الأغذية الخاصة"
                  },
                  {
                    "alias": "text",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "تسجيل الأغذية الخاصة والمكملات الغذائية تسجيلًا كاملًا أو بالإخطار، وإعادة التسجيل."
                  }
                ]
              },
              {
                "contentTypeKey": "91a1f03c-2da9-57ba-a891-9b4dba49ccd8",
                "key": "6a0607d4-2427-5348-8966-f27d8f46cfc2",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "bi-award"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "جهات التقييم والفحص"
                  },
                  {
                    "alias": "text",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "تسجيل جهات تقييم المطابقة وشركات منح الشهادات وشركات الفحص قبل التصدير."
                  }
                ]
              },
              {
                "contentTypeKey": "91a1f03c-2da9-57ba-a891-9b4dba49ccd8",
                "key": "600e2508-9d00-5c4d-a96a-db904c631e5b",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "bi-people"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "المستهلكون"
                  },
                  {
                    "alias": "text",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "تقديم شكوى غذائية ومتابعتها، والتحقق من الشهادات والتراخيص."
                  }
                ]
              }
            ],
            "settingsData": [],
            "expose": [
