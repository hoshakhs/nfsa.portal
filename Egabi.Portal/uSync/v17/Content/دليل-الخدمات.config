  <Properties>
    <intro>
      <Value Culture="ar-EG"><![CDATA[جميع خدمات الهيئة الإلكترونية، مع المتطلبات والمدة المتوقعة لكل خدمة.]]></Value>
      <Value Culture="en-US"><![CDATA[Every GAHAR e-service, with requirements and expected duration.]]></Value>
    </intro>
    <sections>
      <Value Culture="ar-EG"><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "62cd108b-d89b-513a-b90a-2847279e7631",
      "key": "aac74da3-4d02-528b-b69e-01fc4da8a508",
      "values": [
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\u062E\u062F\u0645\u0627\u062A \u0627\u0644\u0647\u064A\u0626\u0629 \u0627\u0644\u0625\u0644\u0643\u062A\u0631\u0648\u0646\u064A\u0629"
        },
        {
          "alias": "cards",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "contentData": [
              {
                "contentTypeKey": "91a1f03c-2da9-57ba-a891-9b4dba49ccd8",
                "key": "f3bf7e27-f33f-5fe8-b11c-ca48d2b695e3",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "bi-award"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0627\u0639\u062A\u0645\u0627\u062F \u0627\u0644\u0645\u0646\u0634\u0622\u062A \u0627\u0644\u0635\u062D\u064A\u0629"
                  },
                  {
                    "alias": "text",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0627\u0644\u062A\u0642\u062F\u0645 \u0644\u0627\u0639\u062A\u0645\u0627\u062F \u0645\u0646\u0634\u0623\u0629 \u0635\u062D\u064A\u0629 \u0648\u0641\u0642 \u0627\u0644\u0645\u0639\u0627\u064A\u064A\u0631 \u0627\u0644\u0642\u0648\u0645\u064A\u0629 \u00B7 90 \u064A\u0648\u0645\u064B\u0627"
                  }
                ]
              },
              {
                "contentTypeKey": "91a1f03c-2da9-57ba-a891-9b4dba49ccd8",
                "key": "e5edb121-33e7-5692-abe0-31f080effe8f",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "bi-patch-check"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0627\u0644\u0627\u0639\u062A\u0645\u0627\u062F \u0627\u0644\u0645\u0628\u062F\u0626\u064A"
                  },
                  {
                    "alias": "text",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0644\u0644\u0645\u0646\u0634\u0622\u062A \u0627\u0644\u062C\u062F\u064A\u062F\u0629 \u0627\u0644\u0645\u0646\u0636\u0645\u0629 \u0625\u0644\u0649 \u0645\u0646\u0638\u0648\u0645\u0629 \u0627\u0644\u062A\u0623\u0645\u064A\u0646 \u0627\u0644\u0635\u062D\u064A \u0627\u0644\u0634\u0627\u0645\u0644 \u00B7 60 \u064A\u0648\u0645\u064B\u0627"
                  }
                ]
              },
              {
                "contentTypeKey": "91a1f03c-2da9-57ba-a891-9b4dba49ccd8",
                "key": "25684ab3-f334-593f-9ce2-4516e2a94d3f",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "bi-arrow-repeat"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u062A\u062C\u062F\u064A\u062F \u0627\u0644\u0627\u0639\u062A\u0645\u0627\u062F"
                  },
                  {
                    "alias": "text",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u062A\u062C\u062F\u064A\u062F \u0634\u0647\u0627\u062F\u0629 \u0627\u0644\u0627\u0639\u062A\u0645\u0627\u062F \u0642\u0628\u0644 \u0627\u0646\u062A\u0647\u0627\u0621 \u0635\u0644\u0627\u062D\u064A\u062A\u0647\u0627 \u00B7 60 \u064A\u0648\u0645\u064B\u0627"
                  }
                ]
              },
              {
                "contentTypeKey": "91a1f03c-2da9-57ba-a891-9b4dba49ccd8",
                "key": "59ef6193-aea5-5a6a-b10f-b57571472c00",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "bi-building-add"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u062A\u0633\u062C\u064A\u0644 \u0645\u0646\u0634\u0623\u0629 \u0635\u062D\u064A\u0629"
                  },
                  {
                    "alias": "text",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0625\u0646\u0634\u0627\u0621 \u0645\u0644\u0641 \u0627\u0644\u0645\u0646\u0634\u0623\u0629 \u0639\u0644\u0649 \u0627\u0644\u0628\u0648\u0627\u0628\u0629 \u0643\u062E\u0637\u0648\u0629 \u0623\u0648\u0644\u0649 \u0644\u0623\u064A \u062E\u062F\u0645\u0629 \u00B7 \u0628\u062F\u0648\u0646 \u0631\u0633\u0648\u0645"
                  }
                ]
              },
              {
                "contentTypeKey": "91a1f03c-2da9-57ba-a891-9b4dba49ccd8",
                "key": "da21f6cb-1987-508b-bb01-d44f05e5fd90",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "bi-person-vcard"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u062A\u0633\u062C\u064A\u0644 \u0623\u0639\u0636\u0627\u0621 \u0627\u0644\u0645\u0647\u0646 \u0627\u0644\u0637\u0628\u064A\u0629"
                  },
                  {
                    "alias": "text",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u062A\u0633\u062C\u064A\u0644 \u0627\u0644\u0623\u0637\u0628\u0627\u0621 \u0648\u0623\u0637\u0628\u0627\u0621 \u0627\u0644\u0623\u0633\u0646\u0627\u0646 \u0648\u0627\u0644\u0635\u064A\u0627\u062F\u0644\u0629 \u0648\u0627\u0644\u062A\u0645\u0631\u064A\u0636 \u00B7 10 \u0623\u064A\u0627\u0645 \u0639\u0645\u0644"
                  }
                ]
              },
              {
                "contentTypeKey": "91a1f03c-2da9-57ba-a891-9b4dba49ccd8",
                "key": "fee8f245-a5a3-53e1-a206-9c31fc4cfb8c",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "bi-clipboard2-check"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0632\u064A\u0627\u0631\u0629 \u062A\u0642\u064A\u064A\u0645 \u062A\u062C\u0631\u064A\u0628\u064A\u0629"
                  },
                  {
                    "alias": "text",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0632\u064A\u0627\u0631\u0629 \u062A\u062D\u0636\u064A\u0631\u064A\u0629 \u0644\u0642\u064A\u0627\u0633 \u062C\u0627\u0647\u0632\u064A\u0629 \u0627\u0644\u0645\u0646\u0634\u0623\u0629 \u0642\u0628\u0644 \u0627\u0644\u062A\u0642\u064A\u064A\u0645 \u0627\u0644\u0631\u0633\u0645\u064A \u00B7 21 \u064A\u0648\u0645\u064B\u0627"
                  }
                ]
              },
              {
                "contentTypeKey": "91a1f03c-2da9-57ba-a891-9b4dba49ccd8",
                "key": "36d095c1-410e-5a05-81a5-0f447d48e404",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "bi-calendar2-check"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0637\u0644\u0628 \u0632\u064A\u0627\u0631\u0629 \u0645\u062A\u0627\u0628\u0639\u0629"
                  },
                  {
                    "alias": "text",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0637\u0644\u0628 \u0632\u064A\u0627\u0631\u0629 \u0644\u0644\u062A\u062D\u0642\u0642 \u0645\u0646 \u0625\u063A\u0644\u0627\u0642 \u0627\u0644\u0645\u0644\u0627\u062D\u0638\u0627\u062A \u00B7 14 \u064A\u0648\u0645\u064B\u0627"
                  }
                ]
              },
              {
                "contentTypeKey": "91a1f03c-2da9-57ba-a891-9b4dba49ccd8",
                "key": "4ef47e02-35d6-5100-bc51-e8e40f1ec405",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "bi-tools"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u062A\u0642\u062F\u064A\u0645 \u062E\u0637\u0629 \u0627\u0644\u0625\u062C\u0631\u0627\u0621\u0627\u062A \u0627\u0644\u062A\u0635\u062D\u064A\u062D\u064A\u0629"
                  },
                  {
                    "alias": "text",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0627\u0644\u0631\u062F \u0639\u0644\u0649 \u0645\u0644\u0627\u062D\u0638\u0627\u062A \u0632\u064A\u0627\u0631\u0629 \u0627\u0644\u062A\u0642\u064A\u064A\u0645 \u0628\u062E\u0637\u0629 \u0648\u0623\u062F\u0644\u0629"
                  }
                ]
              },
              {
                "contentTypeKey": "91a1f03c-2da9-57ba-a891-9b4dba49ccd8",
                "key": "ee9fc5c1-d477-528a-a8cb-52b31cecea4f",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "bi-life-preserver"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0627\u0644\u062F\u0639\u0645 \u0627\u0644\u0641\u0646\u064A (SAT / SAP)"
                  },
                  {
                    "alias": "text",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0645\u0631\u0627\u062C\u0639\u0629 \u0627\u0644\u062A\u0642\u064A\u064A\u0645 \u0627\u0644\u0630\u0627\u062A\u064A \u0623\u0648 \u0637\u0644\u0628 \u0628\u0631\u0646\u0627\u0645\u062C \u062F\u0639\u0645 \u0644\u0644\u062C\u0627\u0647\u0632\u064A\u0629"
                  }
                ]
              },
              {
                "contentTypeKey": "91a1f03c-2da9-57ba-a891-9b4dba49ccd8",
                "key": "7076564f-eeda-53f8-b5d4-84eec0b2aa5b",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "bi-file-earmark-check"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0627\u0633\u062A\u062E\u0631\u0627\u062C \u0635\u0648\u0631\u0629 \u0634\u0647\u0627\u062F\u0629 \u0648\u0627\u0644\u062A\u062D\u0642\u0642 \u0645\u0646\u0647\u0627"
                  },
                  {
                    "alias": "text",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u062A\u0646\u0632\u064A\u0644 \u0646\u0633\u062E\u0629 \u0631\u0642\u0645\u064A\u0629 \u0623\u0648 \u0627\u0644\u062A\u062D\u0642\u0642 \u0645\u0646 \u0635\u062D\u0629 \u0634\u0647\u0627\u062F\u0629 \u0635\u0627\u062F\u0631\u0629 \u00B7 \u0641\u0648\u0631\u064A"
                  }
