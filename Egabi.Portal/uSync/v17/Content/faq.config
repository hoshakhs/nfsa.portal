            }
          }
        }
      ]
    },
    {
      "contentTypeKey": "3f3b3977-b5a1-501f-a860-7390f1c6aa5d",
      "key": "e4cc895f-d7ed-50e0-8703-ecc657619cc1",
      "values": [
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Imports"
        },
        {
          "alias": "items",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "contentData": [
              {
                "contentTypeKey": "eac0e404-1899-5faa-a003-b1e5d1365a89",
                "key": "8be979f4-7e98-5604-acec-35819d055f90",
                "values": [
                  {
                    "alias": "question",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "When do I file the pre-border notice?"
                  },
                  {
                    "alias": "answer",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Between 3 months and 72 hours before the consignment arrives; it can be updated up to 72 hours before arrival. The fee is EGP 2,000 per consignment."
                  }
                ]
              },
              {
                "contentTypeKey": "eac0e404-1899-5faa-a003-b1e5d1365a89",
                "key": "9312bbc4-83ec-5ae6-9cd9-ba2580a58061",
                "values": [
                  {
                    "alias": "question",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "What do the channel colours mean?"
                  },
                  {
                    "alias": "answer",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Green and yellow: final release on arrival with a low sampling rate. Orange and red: temporary release under custody until laboratory results are ready."
                  }
                ]
              },
              {
                "contentTypeKey": "eac0e404-1899-5faa-a003-b1e5d1365a89",
                "key": "696007b9-5903-59a1-9d03-ee5f2e172175",
                "values": [
                  {
                    "alias": "question",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "What happens if a consignment is rejected?"
                  },
                  {
                    "alias": "answer",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "It is re-exported or destroyed under NFSA supervision at the importer's cost; the importer may appeal to the grievance committee."
                  }
                ]
              }
            ],
            "settingsData": [],
            "expose": [
              {
                "contentKey": "8be979f4-7e98-5604-acec-35819d055f90",
                "culture": null,
                "segment": null
              },
