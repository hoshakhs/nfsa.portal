          }
        }
      ]
    },
    {
      "contentTypeKey": "3f3b3977-b5a1-501f-a860-7390f1c6aa5d",
      "key": "c8fb3e6b-4345-51e1-bef6-93e660f6a3d2",
      "values": [
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "الشهادات والرسوم"
        },
        {
          "alias": "items",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "contentData": [
              {
                "contentTypeKey": "eac0e404-1899-5faa-a003-b1e5d1365a89",
                "key": "f4d88d71-7377-5a4f-ab9b-4527aaeef615",
                "values": [
                  {
                    "alias": "question",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "كيف أتحقق من شهادة صادرة من الهيئة؟"
                  },
                  {
                    "alias": "answer",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "تحمل كل شهادة تصدرها البوابة رمز QR يفتح صفحة التحقق منها على البوابة."
                  }
                ]
              },
              {
                "contentTypeKey": "eac0e404-1899-5faa-a003-b1e5d1365a89",
                "key": "a711bd3b-558f-5a21-90a0-a219e3822c44",
                "values": [
                  {
                    "alias": "question",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "كيف أعرف رسوم الخدمة ومدة إنجازها؟"
                  },
                  {
                    "alias": "answer",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "تظهر الرسوم ومدة الإنجاز في صفحة كل خدمة قبل بدء الطلب."
                  }
                ]
              }
            ],
            "settingsData": [],
            "expose": [
              {
                "contentKey": "f4d88d71-7377-5a4f-ab9b-4527aaeef615",
                "culture": null,
                "segment": null
              },
              {
                "contentKey": "a711bd3b-558f-5a21-90a0-a219e3822c44",
                "culture": null,
                "segment": null
              }
            ],
            "layout": {
