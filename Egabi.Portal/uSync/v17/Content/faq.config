              ]
            }
          }
        }
      ]
    },
    {
      "contentTypeKey": "2c3b9d09-c9a0-506a-a092-ef688ee35fb8",
      "key": "735f53dc-5700-50c0-9620-b1f0d8db36bb",
      "values": [
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "لم تجد إجابتك؟"
        },
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "اتصل بالخط الساخن 19565 أو أرسل سؤالك وسنرد خلال يومي عمل."
        },
        {
          "alias": "button",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": [
            {
              "name": "تواصل معنا",
              "target": null,
              "unique": null,
              "type": null,
              "udi": "umb://document/33a8dad41e46532a9fd17387cdaf9b8e",
