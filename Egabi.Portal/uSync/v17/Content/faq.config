      <Value Culture="en-US"><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "3f3b3977-b5a1-501f-a860-7390f1c6aa5d",
      "key": "dd2d6bd2-448c-5b8a-b3c3-6537fcc86df1",
      "values": [
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Account and registration"
        },
        {
          "alias": "items",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "contentData": [
              {
                "contentTypeKey": "eac0e404-1899-5faa-a003-b1e5d1365a89",
                "key": "0a734043-96ff-5749-b8ff-ecca9cd6620b",
                "values": [
                  {
                    "alias": "question",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Who must register an establishment with NFSA?"
                  },
                  {
                    "alias": "answer",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Every establishment that handles food: factories, stores, dairy collection centres, packing stations, slaughterhouses, restaurants, tourism facilities, commercial chains, mobile units, importers and exporters."
                  }
                ]
              },
              {
                "contentTypeKey": "eac0e404-1899-5faa-a003-b1e5d1365a89",
                "key": "932ef774-0765-52aa-beaa-fc8b6b317e8e",
                "values": [
                  {
                    "alias": "question",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Do I need a separate account for each branch?"
                  },
                  {
                    "alias": "answer",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "No. Create one account and register all your establishments under it; each gets its own number and file."
                  }
                ]
              },
              {
                "contentTypeKey": "eac0e404-1899-5faa-a003-b1e5d1365a89",
                "key": "efb3ff49-2003-5e2d-a016-36e5bebc2734",
                "values": [
                  {
                    "alias": "question",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Which documents do I need to register?"
                  },
                  {
                    "alias": "answer",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "The commercial register, tax card and lease or ownership contract, plus documents for your sector such as the industrial register or operating licence. The full list appears while you register."
                  }
                ]
              }
            ],
            "settingsData": [],
            "expose": [
              {
                "contentKey": "0a734043-96ff-5749-b8ff-ecca9cd6620b",
                "culture": null,
                "segment": null
              },
              {
                "contentKey": "932ef774-0765-52aa-beaa-fc8b6b317e8e",
                "culture": null,
                "segment": null
              },
              {
                "contentKey": "efb3ff49-2003-5e2d-a016-36e5bebc2734",
                "culture": null,
                "segment": null
              }
            ],
            "layout": {
