      <Value Culture="en-US"><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "3f3b3977-b5a1-501f-a860-7390f1c6aa5d",
      "key": "1d265e77-e16b-5116-8d09-6ec1a4b7ecc4",
      "values": [
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Account and registration"
        },
        {
          "alias": "items",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "contentData": [
              {
                "contentTypeKey": "eac0e404-1899-5faa-a003-b1e5d1365a89",
                "key": "bc6de481-a34f-593e-a2cd-6c1cb5bedf8f",
                "values": [
                  {
                    "alias": "question",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Who can create an account on the portal?"
                  },
                  {
                    "alias": "answer",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "layout": {}
                      },
                      "markup": "<p>Any Egyptian citizen or resident with a valid national ID or residence number, whether a medical professional or a facility representative.</p>"
                    }
                  }
                ]
              },
              {
                "contentTypeKey": "eac0e404-1899-5faa-a003-b1e5d1365a89",
                "key": "3271222d-affa-5f3f-9011-345c2d940a25",
                "values": [
                  {
                    "alias": "question",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "I forgot my password. What should I do?"
                  },
                  {
                    "alias": "answer",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "layout": {}
                      },
                      "markup": "<p>Select \"Forgot password\" on the sign-in page and we'll send a code to your mobile.</p>"
                    }
                  }
                ]
              },
              {
                "contentTypeKey": "eac0e404-1899-5faa-a003-b1e5d1365a89",
                "key": "d037c470-ab72-54bb-9b1c-3584ead78890",
                "values": [
                  {
                    "alias": "question",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Can I manage more than one facility from one account?"
                  },
                  {
                    "alias": "answer",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "layout": {}
                      },
                      "markup": "<p>Yes, as long as each facility has authorised you.</p>"
                    }
                  }
                ]
              }
            ],
            "settingsData": [],
            "expose": [
              {
                "contentKey": "bc6de481-a34f-593e-a2cd-6c1cb5bedf8f",
                "culture": null,
                "segment": null
              },
              {
                "contentKey": "3271222d-affa-5f3f-9011-345c2d940a25",
                "culture": null,
                "segment": null
              },
              {
                "contentKey": "d037c470-ab72-54bb-9b1c-3584ead78890",
                "culture": null,
                "segment": null
              }
            ],
            "layout": {
              "Umbraco.BlockList": [
                {
                  "contentKey": "bc6de481-a34f-593e-a2cd-6c1cb5bedf8f",
                  "contentUdi": null,
                  "settingsKey": null,
                  "settingsUdi": null
                },
                {
                  "contentKey": "3271222d-affa-5f3f-9011-345c2d940a25",
                  "contentUdi": null,
                  "settingsKey": null,
                  "settingsUdi": null
                },
                {
                  "contentKey": "d037c470-ab72-54bb-9b1c-3584ead78890",
                  "contentUdi": null,
                  "settingsKey": null,
                  "settingsUdi": null
                }
              ]
            }
          }
        }
      ]
    },
    {
      "contentTypeKey": "3f3b3977-b5a1-501f-a860-7390f1c6aa5d",
      "key": "bec9fc60-42fc-5139-a070-c09d6f8e2137",
      "values": [
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Requests and accreditation"
        },
        {
          "alias": "items",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "contentData": [
              {
                "contentTypeKey": "eac0e404-1899-5faa-a003-b1e5d1365a89",
                "key": "91c77cd1-5b64-592a-8b1a-82be750bdc92",
                "values": [
                  {
                    "alias": "question",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "How long does an accreditation request take?"
                  },
                  {
                    "alias": "answer",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "layout": {}
                      },
                      "markup": "<p>About 90 days from document acceptance to decision. The tracking page shows the expected time for each stage.</p>"
                    }
                  }
                ]
              },
              {
                "contentTypeKey": "eac0e404-1899-5faa-a003-b1e5d1365a89",
                "key": "2aeacaa9-c3ab-50f7-9738-d0a048336314",
                "values": [
                  {
                    "alias": "question",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "What happens if the visit raises findings?"
                  },
                  {
                    "alias": "answer",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "layout": {}
                      },
                      "markup": "<p>The facility submits a corrective action plan with evidence within 30 days through the portal.</p>"
                    }
                  }
                ]
              }
            ],
            "settingsData": [],
            "expose": [
              {
                "contentKey": "91c77cd1-5b64-592a-8b1a-82be750bdc92",
                "culture": null,
                "segment": null
              },
              {
                "contentKey": "2aeacaa9-c3ab-50f7-9738-d0a048336314",
                "culture": null,
                "segment": null
              }
            ],
            "layout": {
              "Umbraco.BlockList": [
                {
