    </umbracoUrlName>
    <intro>
      <Value Culture="ar-EG"><![CDATA[إجابات على الأسئلة الأكثر شيوعًا حول البوابة وخدماتها.]]></Value>
      <Value Culture="en-US"><![CDATA[Answers to the most common questions about the portal and its services.]]></Value>
    </intro>
    <sections>
      <Value Culture="ar-EG"><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "3f3b3977-b5a1-501f-a860-7390f1c6aa5d",
      "key": "c7ff0cd2-a64b-5706-b384-2e499c4f19f1",
      "values": [
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "الحساب والتسجيل"
        },
        {
          "alias": "items",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "contentData": [
              {
                "contentTypeKey": "eac0e404-1899-5faa-a003-b1e5d1365a89",
                "key": "0ed09ceb-a09e-55c4-b108-404d545857e8",
                "values": [
                  {
                    "alias": "question",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "من يمكنه إنشاء حساب على البوابة؟"
                  },
                  {
                    "alias": "answer",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "layout": {}
                      },
                      "markup": "<p>أي مواطن مصري أو مقيم لديه رقم قومي أو رقم إقامة ساري، سواء كان عضو مهن طبية أو ممثلًا لمنشأة صحية.</p>"
                    }
                  }
                ]
              },
              {
                "contentTypeKey": "eac0e404-1899-5faa-a003-b1e5d1365a89",
                "key": "e38f1c13-377d-57e0-9bf8-bd6b5cf14c1f",
                "values": [
                  {
                    "alias": "question",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "نسيت كلمة المرور، ماذا أفعل؟"
                  },
                  {
                    "alias": "answer",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "layout": {}
                      },
                      "markup": "<p>اختر «نسيت كلمة المرور» في صفحة تسجيل الدخول وسيصلك رمز على هاتفك المحمول.</p>"
                    }
                  }
                ]
              },
              {
                "contentTypeKey": "eac0e404-1899-5faa-a003-b1e5d1365a89",
                "key": "c9857743-7bb0-5d77-bc33-9d7e5535c5fa",
                "values": [
                  {
                    "alias": "question",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "هل يمكنني إدارة أكثر من منشأة من نفس الحساب؟"
                  },
                  {
                    "alias": "answer",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "layout": {}
                      },
                      "markup": "<p>نعم، بشرط أن تكون مفوضًا من كل منشأة.</p>"
                    }
                  }
                ]
              }
            ],
            "settingsData": [],
            "expose": [
              {
                "contentKey": "0ed09ceb-a09e-55c4-b108-404d545857e8",
                "culture": null,
                "segment": null
              },
              {
                "contentKey": "e38f1c13-377d-57e0-9bf8-bd6b5cf14c1f",
                "culture": null,
                "segment": null
              },
              {
                "contentKey": "c9857743-7bb0-5d77-bc33-9d7e5535c5fa",
                "culture": null,
                "segment": null
              }
            ],
            "layout": {
              "Umbraco.BlockList": [
                {
                  "contentKey": "0ed09ceb-a09e-55c4-b108-404d545857e8",
                  "contentUdi": null,
                  "settingsKey": null,
                  "settingsUdi": null
                },
                {
                  "contentKey": "e38f1c13-377d-57e0-9bf8-bd6b5cf14c1f",
                  "contentUdi": null,
                  "settingsKey": null,
                  "settingsUdi": null
                },
                {
                  "contentKey": "c9857743-7bb0-5d77-bc33-9d7e5535c5fa",
                  "contentUdi": null,
                  "settingsKey": null,
                  "settingsUdi": null
                }
              ]
            }
          }
        }
      ]
    },
    {
      "contentTypeKey": "3f3b3977-b5a1-501f-a860-7390f1c6aa5d",
      "key": "0c724a47-bc24-57c1-ab45-51bfa97205b4",
      "values": [
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "الطلبات والاعتماد"
        },
        {
          "alias": "items",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "contentData": [
              {
                "contentTypeKey": "eac0e404-1899-5faa-a003-b1e5d1365a89",
                "key": "769e8788-ecce-5e36-9164-090bd46077dc",
                "values": [
                  {
                    "alias": "question",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "كم يستغرق طلب الاعتماد؟"
                  },
                  {
                    "alias": "answer",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "layout": {}
                      },
                      "markup": "<p>حوالي 90 يومًا من قبول المستندات حتى صدور القرار، وتظهر المدة المتوقعة لكل مرحلة في صفحة التتبع.</p>"
                    }
                  }
                ]
              },
              {
                "contentTypeKey": "eac0e404-1899-5faa-a003-b1e5d1365a89",
                "key": "e16d846c-8521-523f-9352-958ec4a23994",
                "values": [
                  {
                    "alias": "question",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "ماذا يحدث إذا وردت ملاحظات بعد الزيارة؟"
                  },
                  {
                    "alias": "answer",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "layout": {}
                      },
                      "markup": "<p>تقدم المنشأة خطة إجراءات تصحيحية مع الأدلة خلال 30 يومًا من خلال البوابة.</p>"
                    }
                  }
                ]
              }
            ],
            "settingsData": [],
            "expose": [
              {
                "contentKey": "769e8788-ecce-5e36-9164-090bd46077dc",
                "culture": null,
                "segment": null
              },
              {
                "contentKey": "e16d846c-8521-523f-9352-958ec4a23994",
                "culture": null,
                "segment": null
              }
            ],
            "layout": {
              "Umbraco.BlockList": [
                {
                  "contentKey": "769e8788-ecce-5e36-9164-090bd46077dc",
                  "contentUdi": null,
                  "settingsKey": null,
                  "settingsUdi": null
                },
                {
                  "contentKey": "e16d846c-8521-523f-9352-958ec4a23994",
                  "contentUdi": null,
                  "settingsKey": null,
                  "settingsUdi": null
                }
              ]
            }
          }
        }
      ]
    },
    {
      "contentTypeKey": "3f3b3977-b5a1-501f-a860-7390f1c6aa5d",
      "key": "b25d1100-4c21-5eea-b8ad-9ddd21def1ad",
      "values": [
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "المدفوعات"
        },
        {
          "alias": "items",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "contentData": [
              {
                "contentTypeKey": "eac0e404-1899-5faa-a003-b1e5d1365a89",
                "key": "c02929cd-31e8-5e6e-813c-3ed62cf0faac",
                "values": [
                  {
                    "alias": "question",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "ما وسائل الدفع المتاحة؟"
                  },
                  {
                    "alias": "answer",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "layout": {}
                      },
                      "markup": "<p>البطاقات البنكية (فيزا، ماستركارد، ميزة) وكود فوري والتحويل البنكي.</p>"
                    }
                  }
                ]
              }
            ],
            "settingsData": [],
            "expose": [
              {
                "contentKey": "c02929cd-31e8-5e6e-813c-3ed62cf0faac",
                "culture": null,
                "segment": null
              }
            ],
            "layout": {
              "Umbraco.BlockList": [
                {
                  "contentKey": "c02929cd-31e8-5e6e-813c-3ed62cf0faac",
                  "contentUdi": null,
                  "settingsKey": null,
                  "settingsUdi": null
                }
              ]
            }
          }
        }
      ]
    },
    {
      "contentTypeKey": "2c3b9d09-c9a0-506a-a092-ef688ee35fb8",
      "key": "c1b9106b-3938-5772-9e4a-f2a7eab66f7b",
      "values": [
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "لم تجد إجابتك؟"
        },
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "أرسل استفسارك وسنرد خلال يومي عمل."
        },
        {
          "alias": "button",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": [
            {
              "name": "تواصل معنا",
              "target": null,
              "unique": null,
              "type": null,
              "udi": "umb://document/33a8dad41e46532a9fd17387cdaf9b8e",
              "url": null,
              "queryString": null,
              "culture": null
            }
          ]
        }
      ]
    }
