              ]
            }
          }
        }
      ]
    },
    {
      "contentTypeKey": "3f3b3977-b5a1-501f-a860-7390f1c6aa5d",
      "key": "df0c207c-b2d7-5345-a521-9c70fe1830cd",
      "values": [
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "الاستيراد"
        },
        {
          "alias": "items",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "contentData": [
              {
                "contentTypeKey": "eac0e404-1899-5faa-a003-b1e5d1365a89",
                "key": "2a0b97a2-8eda-5adc-8dfc-2efcef4fe0db",
                "values": [
                  {
                    "alias": "question",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "متى أقدّم الإخطار المسبق عن الرسالة؟"
                  },
                  {
                    "alias": "answer",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "من 3 أشهر حتى 72 ساعة قبل وصول الرسالة، ويمكن تعديله حتى 72 ساعة قبل الوصول. رسوم الإخطار 2,000 جنيه لكل رسالة."
                  }
                ]
              },
              {
                "contentTypeKey": "eac0e404-1899-5faa-a003-b1e5d1365a89",
                "key": "92a4802a-05cf-5b20-80e1-532f2e771193",
                "values": [
                  {
                    "alias": "question",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "ماذا تعني ألوان المسارات؟"
                  },
                  {
                    "alias": "answer",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "الأخضر والأصفر: إفراج نهائي عند الوصول مع نسبة عينات منخفضة. البرتقالي والأحمر: إفراج مؤقت تحت التحفظ حتى ظهور نتائج التحليل."
                  }
                ]
              },
              {
                "contentTypeKey": "eac0e404-1899-5faa-a003-b1e5d1365a89",
                "key": "f0bac3cd-b7ac-5245-8380-c2d7e14392f1",
                "values": [
                  {
                    "alias": "question",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "ماذا يحدث إذا رُفضت الرسالة؟"
                  },
                  {
                    "alias": "answer",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "يُعاد تصديرها أو تُعدم تحت إشراف الهيئة وعلى نفقة المستورد، ويحق للمستورد التظلم أمام لجنة التظلمات."
                  }
                ]
              }
            ],
            "settingsData": [],
            "expose": [
              {
                "contentKey": "2a0b97a2-8eda-5adc-8dfc-2efcef4fe0db",
                "culture": null,
                "segment": null
              },
              {
                "contentKey": "92a4802a-05cf-5b20-80e1-532f2e771193",
                "culture": null,
                "segment": null
              },
              {
                "contentKey": "f0bac3cd-b7ac-5245-8380-c2d7e14392f1",
                "culture": null,
                "segment": null
              }
            ],
            "layout": {
              "Umbraco.BlockList": [
