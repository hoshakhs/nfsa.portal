      "values": [
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Certificates and fees"
        },
        {
          "alias": "items",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "contentData": [
              {
                "contentTypeKey": "eac0e404-1899-5faa-a003-b1e5d1365a89",
                "key": "2068ceff-a8dc-52fa-80df-fe696eda7f79",
                "values": [
                  {
                    "alias": "question",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "How can I check a certificate issued by NFSA?"
                  },
                  {
                    "alias": "answer",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Every certificate the portal issues carries a QR code that opens its verification page on the portal."
                  }
                ]
              },
              {
                "contentTypeKey": "eac0e404-1899-5faa-a003-b1e5d1365a89",
                "key": "b2db0052-321a-5283-bd8d-a5c1e0282354",
                "values": [
                  {
                    "alias": "question",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "How do I know a service's fee and time?"
                  },
                  {
                    "alias": "answer",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "The fee and expected time are shown on each service page before you start."
                  }
                ]
              }
            ],
            "settingsData": [],
            "expose": [
              {
                "contentKey": "2068ceff-a8dc-52fa-80df-fe696eda7f79",
