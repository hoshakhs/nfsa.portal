    </umbracoUrlName>
    <intro>
      <Value Culture="ar-EG"><![CDATA[إجابات عن أكثر الأسئلة شيوعًا حول البوابة وخدمات الهيئة.]]></Value>
      <Value Culture="en-US"><![CDATA[Answers to the most common questions about the portal and NFSA services.]]></Value>
    </intro>
    <sections>
      <Value Culture="ar-EG"><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "3f3b3977-b5a1-501f-a860-7390f1c6aa5d",
      "key": "a2a2ec8f-06a5-5bcd-bd90-646ae02a3829",
      "values": [
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "الحساب والتسجيل"
        },
        {
          "alias": "items",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "contentData": [
              {
                "contentTypeKey": "eac0e404-1899-5faa-a003-b1e5d1365a89",
                "key": "f37b3722-7b59-5085-8133-d9b91794291f",
                "values": [
                  {
                    "alias": "question",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "من يجب عليه تسجيل منشأته لدى الهيئة؟"
                  },
                  {
                    "alias": "answer",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "كل منشأة تتداول الغذاء: المصانع والمخازن ومراكز تجميع الألبان ومحطات التعبئة والمجازر والمطاعم والمنشآت السياحية والسلاسل التجارية والوحدات المتنقلة والمستوردون والمصدرون."
                  }
                ]
              },
              {
                "contentTypeKey": "eac0e404-1899-5faa-a003-b1e5d1365a89",
                "key": "d32e276e-a05f-5812-b3e7-21ecc165a7b9",
                "values": [
                  {
                    "alias": "question",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "هل أحتاج حسابًا منفصلًا لكل فرع؟"
                  },
                  {
                    "alias": "answer",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "لا. أنشئ حسابًا واحدًا وسجّل تحته كل منشآتك، ولكل منشأة رقمها وملفها."
                  }
                ]
              },
              {
                "contentTypeKey": "eac0e404-1899-5faa-a003-b1e5d1365a89",
                "key": "9ef4a1bd-f943-5068-b806-e29818a9b424",
                "values": [
                  {
                    "alias": "question",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "ما المستندات المطلوبة للتسجيل؟"
                  },
                  {
                    "alias": "answer",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "السجل التجاري والبطاقة الضريبية وعقد الإيجار أو التمليك، إلى جانب مستندات حسب القطاع مثل السجل الصناعي أو رخصة مزاولة النشاط. تظهر القائمة كاملة أثناء التسجيل."
                  }
                ]
              }
            ],
            "settingsData": [],
            "expose": [
              {
                "contentKey": "f37b3722-7b59-5085-8133-d9b91794291f",
                "culture": null,
                "segment": null
              },
              {
                "contentKey": "d32e276e-a05f-5812-b3e7-21ecc165a7b9",
                "culture": null,
                "segment": null
              },
              {
                "contentKey": "9ef4a1bd-f943-5068-b806-e29818a9b424",
                "culture": null,
                "segment": null
              }
            ],
            "layout": {
              "Umbraco.BlockList": [
                {
                  "contentKey": "f37b3722-7b59-5085-8133-d9b91794291f",
