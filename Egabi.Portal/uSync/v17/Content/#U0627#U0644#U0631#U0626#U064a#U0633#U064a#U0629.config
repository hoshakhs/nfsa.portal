                  {
                    "alias": "text",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "أنشئ حسابك وسجّل منشأتك مرة واحدة."
                  }
                ]
              },
              {
                "contentTypeKey": "36737075-e135-4c6d-8a2b-7f560a277aa0",
