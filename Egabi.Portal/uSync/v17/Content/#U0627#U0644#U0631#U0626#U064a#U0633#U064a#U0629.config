                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "التقييم الذاتي"
                  },
                  {
                    "alias": "text",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "قيّم منشأتك مقابل معايير الهيئة قبل التقديم."
                  }
                ]
              },
              {
                "contentTypeKey": "36737075-e135-4c6d-8a2b-7f560a277aa0",
