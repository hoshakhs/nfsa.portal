      "values": [
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "How an imported food consignment is released"
        },
        {
          "alias": "steps",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "contentData": [
              {
                "contentTypeKey": "36737075-e135-4c6d-8a2b-7f560a277aa0",
                "key": "117a89b7-92b6-56a8-a523-b25b44a95024",
                "values": [
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Importer licence"
                  },
                  {
                    "alias": "text",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Register your company and get the import licence once."
                  }
                ]
              },
              {
                "contentTypeKey": "36737075-e135-4c6d-8a2b-7f560a277aa0",
                "key": "473e57f1-1741-54be-a4cd-ec8d610fad58",
                "values": [
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Pre-border notice"
                  },
                  {
                    "alias": "text",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Notify the consignment at least 72 hours before it arrives."
                  }
                ]
              },
              {
                "contentTypeKey": "36737075-e135-4c6d-8a2b-7f560a277aa0",
                "key": "657abebf-6fbb-513d-87c9-cf5200f1cca5",
                "values": [
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Risk channel"
                  },
                  {
                    "alias": "text",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "The system sets the channel: green, yellow, orange or red."
                  }
                ]
              },
              {
                "contentTypeKey": "36737075-e135-4c6d-8a2b-7f560a277aa0",
                "key": "9c3f89d6-645f-5ba6-917f-a42404498973",
                "values": [
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Inspection and samples"
                  },
                  {
                    "alias": "text",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "An NFSA committee inspects and samples by channel."
                  }
                ]
              },
              {
                "contentTypeKey": "36737075-e135-4c6d-8a2b-7f560a277aa0",
                "key": "2e7e0df5-8dd9-5e0f-9e45-c47f8e2562ce",
                "values": [
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Release decision"
                  },
                  {
                    "alias": "text",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Receive a release decision with a verifiable QR code."
                  }
