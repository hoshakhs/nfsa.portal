  <Properties>
    <umbracoUrlName>
      <Value Culture="ar-EG"><![CDATA[import-export]]></Value>
      <Value Culture="en-US"><![CDATA[import-export]]></Value>
    </umbracoUrlName>
    <intro>
      <Value Culture="ar-EG"><![CDATA[كل ما يحتاجه المستورد والمصدّر: الترخيص، والإخطار المسبق، والإفراج عن الرسائل، والشهادات الصحية للتصدير.]]></Value>
      <Value Culture="en-US"><![CDATA[Everything importers and exporters need: the licence, the pre-border notice, consignment release and export health certificates.]]></Value>
    </intro>
    <sections>
      <Value Culture="ar-EG"><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "62cd108b-d89b-513a-b90a-2847279e7631",
      "key": "1209cf18-00cd-5ac0-a0c3-16cbb67b8538",
      "values": [
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "خدمات الاستيراد والتصدير"
        },
        {
          "alias": "cards",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "contentData": [
              {
                "contentTypeKey": "91a1f03c-2da9-57ba-a891-9b4dba49ccd8",
                "key": "3706559c-25fe-57d4-81fd-510eedfcf064",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "bi-patch-check"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "ترخيص مستورد أغذية"
                  },
                  {
                    "alias": "text",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "ترخيص إلزامي لكل مستورد أغذية وفق القرار 6 لسنة 2020، ويتطلب مخزنًا مرخصًا أو تعاقدًا مع مخزن مرخص."
                  }
                ]
              },
              {
                "contentTypeKey": "91a1f03c-2da9-57ba-a891-9b4dba49ccd8",
                "key": "caedb88b-8a0f-503c-8a8c-a1c661d7185d",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "bi-send"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "الإخطار المسبق عن الرسالة"
                  },
                  {
                    "alias": "text",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "يُقدَّم من 3 أشهر حتى 72 ساعة قبل الوصول، برقم ACID وأكواد HS وشهادة المطابقة. الرسوم 2,000 جنيه للرسالة."
                  }
                ]
              },
              {
                "contentTypeKey": "91a1f03c-2da9-57ba-a891-9b4dba49ccd8",
                "key": "bbbcfbe4-df3f-5883-90bf-602eb94a348c",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "bi-signpost-split"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "الفحص والإفراج"
                  },
                  {
                    "alias": "text",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "تحدد مسارات المخاطر نسبة الفحص وسحب العينات، ويصدر قرار الإفراج خلال نحو 10 أيام (15 يومًا للمعلبات والمياه المعبأة)."
                  }
                ]
              },
              {
                "contentTypeKey": "91a1f03c-2da9-57ba-a891-9b4dba49ccd8",
                "key": "9673f7bc-4ba7-5bf9-bca1-82962e3c8e62",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "bi-lightning-charge"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "الإفراج السريع عن مستلزمات الإنتاج"
                  },
                  {
                    "alias": "text",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "لمصانع القائمة البيضاء التي تستورد خامات لاستخدامها الخاص، بسحب عينات عشوائية فقط."
                  }
                ]
              },
              {
                "contentTypeKey": "91a1f03c-2da9-57ba-a891-9b4dba49ccd8",
                "key": "cdcf09f9-1733-582c-a68d-5fa1998c3647",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "bi-chat-square-text"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "التظلم من قرار"
                  },
                  {
                    "alias": "text",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "يحق للمستورد التظلم من قرار الرفض أمام لجنة التظلمات، التي قد تأمر بإعادة التحليل."
                  }
                ]
              },
              {
                "contentTypeKey": "91a1f03c-2da9-57ba-a891-9b4dba49ccd8",
                "key": "50a0137c-0cd9-573c-893f-0c43b780f1bc",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "bi-arrow-repeat"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "إعادة التصدير أو الإعدام"
                  },
                  {
                    "alias": "text",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "تُعاد الرسائل المرفوضة إلى التصدير أو تُعدم تحت إشراف الهيئة وعلى نفقة المستورد."
                  }
                ]
              },
              {
                "contentTypeKey": "91a1f03c-2da9-57ba-a891-9b4dba49ccd8",
                "key": "ff9db8d6-9c48-54f2-bb0f-a168b7b268c8",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "bi-globe2"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "الشهادة الصحية للتصدير"
                  },
                  {
                    "alias": "text",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "تصدرها الهيئة للرسائل الغذائية المصدّرة بعد مراجعة المستندات والفحص عند الحاجة."
                  }
                ]
              }
            ],
            "settingsData": [],
            "expose": [
              {
                "contentKey": "3706559c-25fe-57d4-81fd-510eedfcf064",
                "culture": null,
                "segment": null
