      <Value Culture="en-US"><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "62cd108b-d89b-513a-b90a-2847279e7631",
      "key": "55a273a2-b2a6-569a-ab2c-1b15b02722c0",
      "values": [
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Import and export services"
        },
        {
          "alias": "cards",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "contentData": [
              {
                "contentTypeKey": "91a1f03c-2da9-57ba-a891-9b4dba49ccd8",
                "key": "a944a5f6-1f84-51a2-a58c-fd3edc6416e6",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "bi-patch-check"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Food importer licence"
                  },
                  {
                    "alias": "text",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Required for every food importer under Decision 6/2020, with a licensed store or a contract with one."
                  }
                ]
              },
              {
                "contentTypeKey": "91a1f03c-2da9-57ba-a891-9b4dba49ccd8",
                "key": "e826e696-1504-54a3-8a69-84ae3ed23f39",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "bi-send"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Pre-border notice"
                  },
                  {
                    "alias": "text",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Filed 3 months to 72 hours before arrival, with the ACID, HS codes and conformity certificate. Fee: EGP 2,000 per consignment."
                  }
                ]
              },
              {
                "contentTypeKey": "91a1f03c-2da9-57ba-a891-9b4dba49ccd8",
                "key": "0e1d64be-7b0e-5865-b714-94e46382ea30",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "bi-signpost-split"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Inspection and release"
                  },
                  {
                    "alias": "text",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Risk channels set the inspection and sampling rate; the release decision comes in about 10 days (15 for canned food and bottled water)."
                  }
                ]
              },
              {
                "contentTypeKey": "91a1f03c-2da9-57ba-a891-9b4dba49ccd8",
                "key": "0a88071b-5ea0-59a1-a835-b67ae2bd86cb",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "bi-lightning-charge"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Fast release of production inputs"
                  },
                  {
                    "alias": "text",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "For white-list factories importing inputs for their own use, with random sampling only."
                  }
                ]
              },
              {
                "contentTypeKey": "91a1f03c-2da9-57ba-a891-9b4dba49ccd8",
                "key": "ca02b07a-b5a5-5797-b495-404eca03323a",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "bi-chat-square-text"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Grievance against a decision"
                  },
                  {
                    "alias": "text",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Importers may appeal a rejection to the grievance committee, which may order a re-test."
                  }
                ]
              },
              {
                "contentTypeKey": "91a1f03c-2da9-57ba-a891-9b4dba49ccd8",
                "key": "a856a961-28a3-5ee9-93f1-53788a1f03b8",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "bi-arrow-repeat"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Re-export or destruction"
                  },
                  {
                    "alias": "text",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Rejected consignments are re-exported or destroyed under NFSA supervision, at the importer's cost."
                  }
                ]
              },
              {
                "contentTypeKey": "91a1f03c-2da9-57ba-a891-9b4dba49ccd8",
                "key": "35b31c87-3043-59d1-bb6a-5554b4059fe6",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "bi-globe2"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Export health certificate"
                  },
                  {
                    "alias": "text",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Issued by NFSA for exported food consignments after a document check and inspection where needed."
                  }
                ]
              }
            ],
            "settingsData": [],
            "expose": [
              {
                "contentKey": "a944a5f6-1f84-51a2-a58c-fd3edc6416e6",
                "culture": null,
