        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "التقدم للاعتماد لأول مرة"
        },
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "سجّل منشأتك، وأكمل التقييم الذاتي، ثم قدّم طلب الاعتماد. يمكنك طلب زيارة تجريبية قبل التقييم الرسمي."
        },
        {
          "alias": "button",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": [
            {
              "name": "قدّم طلب اعتماد",
              "target": null,
              "unique": null,
              "type": null,
              "udi": null,
              "url": "/account/login",
              "queryString": null,
              "culture": null
            }
          ]
        }
      ]
    },
