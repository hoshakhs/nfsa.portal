      "values": [
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Exporting food?"
        },
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Request the export health certificate from the services catalogue. Some countries, such as Saudi Arabia, first require the factory to be on their list."
