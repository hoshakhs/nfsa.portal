      "values": [
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Importing for the first time?"
        },
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Register your establishment, get the importer licence, then file the pre-border notice at least 72 hours before your first consignment arrives."
        },
        {
          "alias": "button",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": [
            {
              "name": "Register an establishment",
              "target": null,
              "unique": null,
              "type": null,
              "udi": "umb://document/206ee20c93c65a149616202b72592b0c",
              "url": null,
              "queryString": null,
