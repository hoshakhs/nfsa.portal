      "values": [
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "تجديد الاعتماد"
        },
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "تُفتح نافذة التجديد قبل 180 يومًا من تاريخ انتهاء الشهادة، وستصلك رسالة تذكير عند فتحها."
        },
