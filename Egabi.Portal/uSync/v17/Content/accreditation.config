            }
          }
        }
      ]
    },
    {
      "contentTypeKey": "2c3b9d09-c9a0-506a-a092-ef688ee35fb8",
      "key": "f029665f-b645-5795-b5c8-19495f338c9b",
      "values": [
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "تستورد لأول مرة؟"
        },
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "سجّل منشأتك، واحصل على ترخيص المستورد، ثم قدّم الإخطار المسبق عن أول رسالة قبل وصولها بـ 72 ساعة على الأقل."
        },
        {
          "alias": "button",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": [
            {
              "name": "تسجيل منشأة",
              "target": null,
              "unique": null,
              "type": null,
              "udi": "umb://document/206ee20c93c65a149616202b72592b0c",
              "url": null,
              "queryString": null,
              "culture": null
            }
          ]
        }
      ]
    },
    {
      "contentTypeKey": "2c3b9d09-c9a0-506a-a092-ef688ee35fb8",
      "key": "a179065b-0d80-5e45-ac21-f62db17ce43f",
      "values": [
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "تصدّر منتجات غذائية؟"
        },
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "اطلب الشهادة الصحية للتصدير من دليل الخدمات. تشترط بعض الدول قيد المصنع في قوائمها أولًا، مثل المملكة العربية السعودية."
        },
        {
          "alias": "button",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": [
            {
              "name": "دليل الخدمات",
              "target": null,
              "unique": null,
              "type": null,
              "udi": "umb://document/266ea669cfce562d8713fb8903bd0c99",
              "url": null,
              "queryString": null,
              "culture": null
            }
          ]
        }
      ]
    }
  ],
